NAUTILUS_SERVER_PORT=3069
NAUTILUS_CLIENT_PORT=3070
NAUTILUS_HOST="localhost"

# Security Configuration
# IMPORTANT: Change these credentials in production!
# Use strong, unique passwords for production deployments
NAUTILUS_ADMIN_USERNAME=admin
NAUTILUS_ADMIN_PASSWORD=changeme_use_strong_password_here
# These are only used on first boot. After you change the credentials in
# Settings → Account they are stored hashed in credentials.json and win over
# the values above. Set to true for one start to discard them (forgot password).
# NAUTILUS_RESET_CREDENTIALS=false

# Authless mode for local/trusted-LAN use only: no login, and every client on a
# loopback/private address is admin. Never use on an internet-exposed instance.
# NAUTILUS_AUTH_DISABLED=false

# Additional Security Notes:
# - Consider using a reverse proxy with TLS termination
# - Restrict network access to this application
# - Monitor logs for authentication failures
# - Change default credentials immediately
